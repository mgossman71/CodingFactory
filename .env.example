# Copy to .env and adjust. Never commit .env.

# --- Shared LLM (all agents use this one endpoint/model) ---
LLM_BASE_URL=http://lxc-strata2:8080/v1
LLM_API_KEY=
LLM_MODEL=qwen3.8-flash-next-iq3_s
LLM_MAX_CONCURRENT_REQUESTS=1
LLM_REQUEST_TIMEOUT=600
LLM_MAX_RETRIES=3

# --- Workflow bounds ---
MAX_DISCOVERY_ROUNDS=2
MAX_TASKS=12
MAX_TASK_ATTEMPTS=3

# --- Storage (relative to process CWD) ---
DATA_DIR=./data
WORKSPACES_DIR=./workspaces

# IP of the LLM host for the container (compose extra_hosts). Leave unset for host-gateway if the LLM runs on this machine.
STRATA2_IP=192.168.1.100
